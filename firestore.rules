rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // IST is UTC+5:30; shifting by (330 - cutoff) minutes makes the UTC date equal the business day.
    function bizDay(shopId, t) {
      let b = t + duration.value(330 - getShop(shopId).get('dayCutoffMin', 270), 'm');
      return string(b.year()) + '-'
        + (b.month() < 10 ? '0' : '') + string(b.month()) + '-'
        + (b.day() < 10 ? '0' : '') + string(b.day());
    }

    function isAuthenticated() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function getShop(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)).data;
    }

    function mapValuesAreRoles(memberMap) {
      return memberMap.size() <= 50 && memberMap.values().hasOnly(['admin', 'member']);
    }

    function isMember(shopId) {
      return isAuthenticated() &&
        getShop(shopId).members[request.auth.uid] != null;
    }

    function isAdmin(shopId) {
      return isAuthenticated() &&
        getShop(shopId).members[request.auth.uid] == 'admin';
    }

    function isSoleAdmin(shopId) {
      return isAdmin(shopId) && getShop(shopId).members.size() == 1;
    }

    function isValidVariantFields(d) {
      return (!('hasImage' in d) || d.hasImage is bool)
        && (!('groupId' in d) || isValidString(d.groupId, 1, 40))
        && (!('baseName' in d) || isValidString(d.baseName, 1, 100))
        && (!('options' in d) || (d.options is map && d.options.size() >= 1 && d.options.size() <= 3));
    }

    // ---- Invoice numbers (GST serial) -------------------------------------------------
    // A bill's number must be the next number of its series, and the counter must move up by one in the SAME
    // write, so a number can never be reused, skipped or invented. Sales: 26-27/000123. Returns: R/26-27/000045.
    function pad2(n) { return n < 10 ? '0' + string(n) : string(n); }
    function pad6(n) {
      return n < 10 ? '00000' + string(n) : n < 100 ? '0000' + string(n) : n < 1000 ? '000' + string(n)
        : n < 10000 ? '00' + string(n) : n < 100000 ? '0' + string(n) : string(n);
    }
    // Current financial year label in India time (April to March), e.g. 26-27.
    function fyLabelNow() {
      let t = request.time + duration.value(330, 'm');
      let y = t.month() >= 4 ? t.year() : t.year() - 1;
      return pad2(y % 100) + '-' + pad2((y + 1) % 100);
    }
    function billCounterPath(shopId, billNo) {
      let parts = billNo.split('/');
      return /databases/$(database)/documents/shops/$(shopId)/billCounters/$(parts[0] == 'R'
        ? parts[1].split('-')[0] + parts[1].split('-')[1] + '-R'
        : parts[0].split('-')[0] + parts[0].split('-')[1]);
    }
    function billNoOk(shopId, billNo, isReturn) {
      return billNo is string
        && billNo.matches(isReturn ? '^R/\\d{2}-\\d{2}/\\d{6}$' : '^\\d{2}-\\d{2}/\\d{6}$')
        && billNo.split('/')[isReturn ? 1 : 0] == fyLabelNow()
        && getAfter(billCounterPath(shopId, billNo)).data.keys().hasOnly(['last'])
        && billNo.split('/')[isReturn ? 2 : 1] == pad6(getAfter(billCounterPath(shopId, billNo)).data.last)
        && getAfter(billCounterPath(shopId, billNo)).data.last
             == (exists(billCounterPath(shopId, billNo)) ? get(billCounterPath(shopId, billNo)).data.last + 1 : 1);
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    match /shops/{shopId} {
      allow read: if isAuthenticated() &&
        resource.data.members[request.auth.uid] != null;

      // Only a verified email can open a shop (Google accounts always are), so throwaway sign-ups cannot create shops.
      allow create: if isAuthenticated() &&
        request.auth.token.email_verified == true &&
        request.resource.data.keys().hasOnly(['name', 'ownerId', 'members']) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.members[request.auth.uid] == 'admin' &&
        request.resource.data.members.size() == 1 &&
        isValidString(request.resource.data.name, 1, 60);

      allow update: if (
          resource.data.members[request.auth.uid] == 'admin'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'members', 'ownerId', 'phone', 'address', 'tagline', 'dayCutoffMin', 'updatedAt'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']) || isValidString(request.resource.data.name, 1, 60))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['dayCutoffMin']) || (request.resource.data.dayCutoffMin is int && request.resource.data.dayCutoffMin >= 0 && request.resource.data.dayCutoffMin <= 330))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone']) || isValidString(request.resource.data.phone, 0, 30))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['address']) || isValidString(request.resource.data.address, 0, 200))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['tagline']) || isValidString(request.resource.data.tagline, 0, 100))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['members', 'ownerId'])
              || request.auth.uid == resource.data.ownerId)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['members'])
              || (request.resource.data.members.values().hasAny(['admin']) && mapValuesAreRoles(request.resource.data.members)))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['members', 'ownerId'])
              || request.resource.data.members[request.resource.data.ownerId] == 'admin')
        ) || (
          (request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
          && request.auth.uid != resource.data.ownerId
          && !(request.auth.uid in request.resource.data.members)
          && (resource.data.members[request.auth.uid] != 'admin' || request.resource.data.members.values().hasAny(['admin']))
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
        ) || (
          !(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'consumedInviteCode', 'updatedAt'])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.members[request.auth.uid] == 'member'
          && request.resource.data.members.size() <= 50
          && 'consumedInviteCode' in request.resource.data
          && get(/databases/$(database)/documents/invites/$(request.resource.data.consumedInviteCode)).data.claimedBy == null
          && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.consumedInviteCode)).data.claimedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.consumedInviteCode)).data.shopId == shopId
        );

      allow delete: if resource.data.members[request.auth.uid] == 'admin'
        && resource.data.members.size() == 1;

      // Running invoice number per financial year. Each save moves it up by exactly one, so numbers never repeat or skip.
      match /billCounters/{series} {
        allow get: if isMember(shopId);
        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly(['last'])
          && request.resource.data.last == 1;
        allow update: if isMember(shopId)
          && request.resource.data.keys().hasOnly(['last'])
          && request.resource.data.last == resource.data.last + 1;
        // Only the whole-shop delete removes counters. Otherwise numbers could restart at 1 and repeat.
        allow delete: if isSoleAdmin(shopId);
      }

      match /bills/{billId} {
        allow get: if isMember(shopId);
        allow list: if isMember(shopId) && request.query.limit <= 100;

        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly(['creatorId', 'items', 'subtotal', 'grandTotal', 'paymentMethod', 'payment', 'shopName', 'billNo', 'clientCreatedAt', 'createdAt', 'globalDiscount', 'globalDiscountAmt', 'type', 'originalBillId', 'refundMethod', 'exchangeOf'])
          && isValidString(request.resource.data.get('exchangeOf', 'x'), 1, 40)
          && request.resource.data.creatorId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 100
          && request.resource.data.subtotal is number
          && request.resource.data.grandTotal is number
          && request.resource.data.paymentMethod is string
          && (
            (request.resource.data.get('type', 'sale') == 'sale'
              && request.resource.data.subtotal >= 0
              && request.resource.data.get('globalDiscountAmt', 0) is number
              && request.resource.data.get('globalDiscountAmt', 0) >= 0
              && request.resource.data.grandTotal == request.resource.data.subtotal - request.resource.data.get('globalDiscountAmt', 0)
              && request.resource.data.grandTotal >= 0
              && request.resource.data.paymentMethod in ['cash', 'upi', 'split']
              && billNoOk(shopId, request.resource.data.get('billNo', null), false))
            ||
            (request.resource.data.get('type', 'sale') == 'return'
              && request.resource.data.subtotal < 0
              && request.resource.data.grandTotal == request.resource.data.subtotal
              && request.resource.data.paymentMethod in ['cash', 'upi']
              && billNoOk(shopId, request.resource.data.get('billNo', null), true)
              && request.resource.data.originalBillId is string
              && exists(/databases/$(database)/documents/shops/$(shopId)/bills/$(request.resource.data.originalBillId))
              && (isAdmin(shopId) || request.time < get(/databases/$(database)/documents/shops/$(shopId)/bills/$(request.resource.data.originalBillId)).data.createdAt + duration.value(1, 'd'))
              && get(/databases/$(database)/documents/shops/$(shopId)/bills/$(request.resource.data.originalBillId)).data.get('type', 'sale') == 'sale'
              && getAfter(/databases/$(database)/documents/shops/$(shopId)/bills/$(request.resource.data.originalBillId)).data.get('returnedAmt', 0)
                   == get(/databases/$(database)/documents/shops/$(shopId)/bills/$(request.resource.data.originalBillId)).data.get('returnedAmt', 0) - request.resource.data.grandTotal
              && getAfter(/databases/$(database)/documents/shops/$(shopId)/bills/$(request.resource.data.originalBillId)).data.get('returnedAmt', 0)
                   <= get(/databases/$(database)/documents/shops/$(shopId)/bills/$(request.resource.data.originalBillId)).data.grandTotal)
          );

        allow update: if isMember(shopId) && (
          (
            ((isAdmin(shopId) && request.time < resource.data.createdAt + duration.value(1, 'd'))
              || (resource.data.creatorId == request.auth.uid && request.time < resource.data.createdAt + duration.value(1, 'h')))
            && resource.data.get('type', 'sale') == 'sale'
            && resource.data.get('returnedAmt', 0) == 0
            && !('exchangeOf' in resource.data)
            && request.resource.data.type == 'reversal'
            && request.resource.data.grandTotal == resource.data.grandTotal
            && request.resource.data.creatorId == resource.data.creatorId
            && request.resource.data.reversedBy == request.auth.uid
            && request.resource.data.reversedAt == request.time
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['type', 'originalBillId', 'reversedAt', 'reversedBy'])
          ) || (
            ((isAdmin(shopId) && request.time < resource.data.createdAt + duration.value(1, 'd'))
              || (resource.data.creatorId == request.auth.uid && request.time < resource.data.createdAt + duration.value(1, 'h')))
            && resource.data.get('type', 'sale') == 'sale'
            && resource.data.get('returnedAmt', 0) == 0
            && !('exchangeOf' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentMethod', 'payment'])
            && request.resource.data.paymentMethod in ['cash', 'upi', 'split']
            && request.resource.data.payment is map
            && request.resource.data.payment.method == request.resource.data.paymentMethod
            && request.resource.data.payment.breakdown.cash is number
            && request.resource.data.payment.breakdown.upi is number
            && request.resource.data.payment.breakdown.cash >= 0
            && request.resource.data.payment.breakdown.upi >= 0
            && request.resource.data.payment.breakdown.cash + request.resource.data.payment.breakdown.upi == resource.data.grandTotal
            && (request.resource.data.paymentMethod != 'cash' || request.resource.data.payment.breakdown.upi == 0)
            && (request.resource.data.paymentMethod != 'upi' || request.resource.data.payment.breakdown.cash == 0)
            && (request.resource.data.paymentMethod != 'split' || (request.resource.data.payment.breakdown.cash > 0 && request.resource.data.payment.breakdown.upi > 0))
          ) || (
            // a refund total moves only by a return: the owner any time, staff within a day of the sale
            (isAdmin(shopId) || request.time < resource.data.createdAt + duration.value(1, 'd'))
            && resource.data.get('type', 'sale') == 'sale'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['returnedAmt'])
            && request.resource.data.returnedAmt is number
            && request.resource.data.returnedAmt > resource.data.get('returnedAmt', 0)
            && request.resource.data.returnedAmt <= resource.data.grandTotal
          )
        );

        allow delete: if isSoleAdmin(shopId);
      }

      match /expenses/{expenseId} {
        allow get: if isMember(shopId);
        allow list: if isMember(shopId) && request.query.limit <= 100;

        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly(['amount', 'category', 'description', 'paidVia', 'creatorId', 'createdAt', 'clientCreatedAt'])
          && request.resource.data.keys().hasAll(['amount', 'category', 'description', 'creatorId', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 100000000
          && isValidString(request.resource.data.category, 1, 50)
          && isValidString(request.resource.data.description, 0, 200)
          && request.resource.data.get('paidVia', 'cash') in ['cash', 'upi', 'staff']
          && request.resource.data.creatorId == request.auth.uid;

        allow update: if isMember(shopId)
          && (isAdmin(shopId) || (resource.data.creatorId == request.auth.uid && request.time < resource.data.createdAt + duration.value(1, 'd')))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount', 'category', 'description', 'paidVia', 'updatedAt'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['paidVia']) || request.resource.data.paidVia in ['cash', 'upi', 'staff'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount']) || (request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 100000000))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['category']) || isValidString(request.resource.data.category, 1, 50))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['description']) || isValidString(request.resource.data.description, 0, 200));

        allow delete: if isMember(shopId) && isAdmin(shopId);
      }

      // Cash a staff member takes from the drawer: salary advance, debt (a loan), or a repayment.
      // Append-only (no edits); only an admin can delete a wrong entry.
      // A repayment taken off salary moves no cash, so it can wipe a debt without anyone checking: only an admin may record it.
      match /staffCash/{entryId} {
        allow get: if isMember(shopId);
        allow list: if isMember(shopId) && request.query.limit <= 100;
        // advance, debt, repay: money in or out of the drawer. work: a day worked (units 1 or 0.5, amount = wage earned).
        // payout: wage paid out. close: marks that the period was settled up. work, payout and close are the owner's.
        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly(['staff', 'kind', 'amount', 'via', 'note', 'monthly', 'units', 'creatorId', 'createdAt'])
          && request.resource.data.keys().hasAll(['staff', 'kind', 'amount', 'creatorId', 'createdAt'])
          && isValidString(request.resource.data.staff, 1, 40)
          && request.resource.data.kind in ['advance', 'debt', 'repay', 'work', 'payout', 'close']
          && request.resource.data.amount is number
          && request.resource.data.amount <= 100000000
          && (request.resource.data.kind == 'close' ? request.resource.data.amount >= 0 : request.resource.data.amount > 0)
          && (request.resource.data.kind in ['repay', 'payout'] || !('via' in request.resource.data))
          && (request.resource.data.kind != 'repay' || request.resource.data.get('via', 'cash') in ['cash', 'salary', 'waive'])
          && (request.resource.data.kind != 'payout' || request.resource.data.get('via', 'x') in ['cash', 'upi'])
          && (!(request.resource.data.get('via', 'cash') in ['salary', 'waive']) || isAdmin(shopId))
          && (!(request.resource.data.kind in ['work', 'payout', 'close']) || isAdmin(shopId))
          && (request.resource.data.kind != 'work' || request.resource.data.get('units', 0) in [0.5, 1])
          && (request.resource.data.kind == 'work' || !('units' in request.resource.data))
          && isValidString(request.resource.data.get('note', ''), 0, 200)
          && (!('monthly' in request.resource.data) || (request.resource.data.kind in ['advance', 'debt'] && request.resource.data.monthly is number && request.resource.data.monthly >= 0 && request.resource.data.monthly <= 100000000))
          && request.resource.data.creatorId == request.auth.uid
          && request.resource.data.createdAt == request.time;
        // the owner can correct an entry's amount, note or monthly deduction; who, when and what kind stay as recorded
        allow update: if isAdmin(shopId)
          && resource.data.kind != 'close'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount', 'note', 'monthly'])
          && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 100000000
          && isValidString(request.resource.data.get('note', ''), 0, 200)
          && (!('monthly' in request.resource.data) || (resource.data.kind in ['advance', 'debt'] && request.resource.data.monthly is number && request.resource.data.monthly >= 0 && request.resource.data.monthly <= 100000000));
        allow delete: if isAdmin(shopId);
      }

      // Daily wage and how often each person is paid. Only the owner sees or sets it.
      match /staffPeople/{personId} {
        allow get: if isAdmin(shopId);
        allow list: if isAdmin(shopId) && request.query.limit <= 100;
        allow create, update: if isAdmin(shopId)
          && request.resource.data.keys().hasOnly(['staff', 'wage', 'cycle', 'updatedAt'])
          && request.resource.data.keys().hasAll(['staff', 'wage', 'cycle'])
          && isValidString(request.resource.data.staff, 1, 40)
          && request.resource.data.wage is number && request.resource.data.wage >= 0 && request.resource.data.wage <= 100000000
          && request.resource.data.cycle in ['day', 'week', 'month'];
        allow delete: if isSoleAdmin(shopId);
      }

      match /dailyClosures/{closureId} {
        allow get: if isMember(shopId);
        allow list: if isMember(shopId) && request.query.limit <= 100;
        // A saved count can only be created, so a cashier cannot overwrite the difference afterwards; only an admin can change one.
        allow create: if isMember(shopId)
          && closureId.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && closureId <= bizDay(shopId, request.time)
          && (isAdmin(shopId) || closureId >= bizDay(shopId, request.time - duration.value(1, 'd')))
          && request.resource.data.creatorId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['expectedCash', 'actualCash', 'difference', 'creatorId', 'createdAt', 'date'])
          && request.resource.data.expectedCash is number
          && request.resource.data.actualCash is number
          && request.resource.data.difference is number
          && request.resource.data.date == closureId;
        allow update: if isAdmin(shopId)
          && closureId.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && closureId <= bizDay(shopId, request.time)
          && (isAdmin(shopId) || closureId >= bizDay(shopId, request.time - duration.value(1, 'd')))
          && request.resource.data.creatorId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.keys().hasOnly(['expectedCash', 'actualCash', 'difference', 'creatorId', 'createdAt', 'date'])
          && request.resource.data.expectedCash is number
          && request.resource.data.actualCash is number
          && request.resource.data.difference is number
          && request.resource.data.date == closureId;
        allow delete: if isSoleAdmin(shopId);
      }

      match /dailyStats/{day} {
        allow get: if isMember(shopId);
        allow list: if isMember(shopId) && request.query.limit <= 100;
        allow create, update: if isMember(shopId)
          && day.matches('^\\d{4}-\\d{2}-\\d{2}$')
          && request.resource.data.keys().hasOnly(['date', 'rev', 'cash', 'upi', 'splitCash', 'splitUpi', 'bills', 'exp', 'expCash', 'cats'])
          && request.resource.data.keys().hasAll(['date', 'rev', 'cash', 'upi', 'splitCash', 'splitUpi', 'bills', 'exp', 'expCash'])
          && request.resource.data.date == day
          && day <= bizDay(shopId, request.time)
          && (isAdmin(shopId) || day >= bizDay(shopId, request.time - duration.value(1, 'd')))
          && request.resource.data.rev is number
          && request.resource.data.cash is number
          && request.resource.data.upi is number
          && request.resource.data.splitCash is number
          && request.resource.data.splitUpi is number
          && request.resource.data.bills is number
          && request.resource.data.exp is number
          && request.resource.data.expCash is number
          && request.resource.data.get('cats', {}) is map;
        allow delete: if isSoleAdmin(shopId);
      }

      match /transfers/{transferId} {
        allow get: if isMember(shopId);
        allow list: if isMember(shopId) && request.query.limit <= 100;
        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly(['direction', 'party', 'productId', 'name', 'qty', 'unitPrice', 'creatorId', 'createdAt'])
          && request.resource.data.keys().hasAll(['direction', 'party', 'productId', 'name', 'qty', 'creatorId', 'createdAt'])
          && request.resource.data.direction in ['in', 'out']
          && isValidString(request.resource.data.party, 1, 60)
          && isValidString(request.resource.data.name, 1, 100)
          && isValidString(request.resource.data.productId, 1, 128)
          && request.resource.data.qty is number && request.resource.data.qty > 0 && request.resource.data.qty <= 100000
          && (request.resource.data.get('unitPrice', null) == null || (request.resource.data.unitPrice is number && request.resource.data.unitPrice >= 0))
          && request.resource.data.creatorId == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow delete: if isSoleAdmin(shopId);
      }

      match /memberProfiles/{uid} {
        allow get: if isMember(shopId);
        allow list: if isMember(shopId) && request.query.limit <= 100;
        allow create, update: if isMember(shopId)
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'updatedAt'])
          && isValidString(request.resource.data.name, 1, 80)
          && request.resource.data.updatedAt == request.time;
        allow delete: if uid == request.auth.uid || isSoleAdmin(shopId);
      }

      // Activity log: members add entries, nobody edits them. Only the owner reads, and only deleting the whole shop removes them.
      match /auditLogs/{logId} {
        allow get: if isAdmin(shopId);
        allow list: if isAdmin(shopId) && request.query.limit <= 100;
        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly(['action', 'uid', 'billNo', 'billId', 'amount', 'note', 'createdAt'])
          && request.resource.data.keys().hasAll(['action', 'uid', 'createdAt'])
          && request.resource.data.action in ['void', 'payment_change', 'return', 'discount', 'expense_delete', 'import', 'staff_edit', 'staff_delete', 'staff_settle', 'staff_loan_close']
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && isValidString(request.resource.data.get('billNo', ''), 0, 40)
          && isValidString(request.resource.data.get('billId', ''), 0, 128)
          && isValidString(request.resource.data.get('note', ''), 0, 200)
          && request.resource.data.get('amount', 0) is number;
        allow update: if false;
        allow delete: if isSoleAdmin(shopId);
      }

      match /errorLogs/{logId} {
        allow get: if isAdmin(shopId);
        allow list: if isAdmin(shopId) && request.query.limit <= 100;
        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly(['msg', 'stack', 'screen', 'uid', 'createdAt'])
          && request.resource.data.keys().hasAll(['msg', 'uid', 'createdAt'])
          && isValidString(request.resource.data.msg, 1, 300)
          && isValidString(request.resource.data.get('stack', ''), 0, 1500)
          && isValidString(request.resource.data.get('screen', ''), 0, 100)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow delete: if isAdmin(shopId);
      }

      match /catalog/{productId} {
        allow read: if isMember(shopId);
        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly(['name', 'lastUsedPrice', 'unit', 'stockCount', 'lowStockAlert', 'category', 'description', 'isActive', 'updatedAt', 'frequency', 'createdAt', 'createdBy', 'addedBy', 'source', 'costPrice', 'groupId', 'baseName', 'options', 'hasImage'])
          && isValidVariantFields(request.resource.data)
          && isValidString(request.resource.data.name, 1, 100)
          && request.resource.data.lastUsedPrice is number && request.resource.data.lastUsedPrice >= 0
          && (request.resource.data.get('stockCount', null) == null || (request.resource.data.stockCount is number && request.resource.data.stockCount >= 0))
          && isValidString(request.resource.data.get('source', ''), 0, 60)
          && (request.resource.data.get('costPrice', null) == null || (request.resource.data.costPrice is number && request.resource.data.costPrice >= 0))
          && request.resource.data.updatedAt == request.time;
        allow update: if isMember(shopId)
          && request.resource.data.updatedAt == request.time
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['stockCount']) || (request.resource.data.stockCount == null || (request.resource.data.stockCount is number && request.resource.data.stockCount >= 0)))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastUsedPrice']) || (request.resource.data.lastUsedPrice is number && request.resource.data.lastUsedPrice >= 0))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']) || isValidString(request.resource.data.name, 1, 100))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['source']) || isValidString(request.resource.data.source, 0, 60))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['costPrice']) || request.resource.data.costPrice == null || (request.resource.data.costPrice is number && request.resource.data.costPrice >= 0))
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              'source', 'costPrice', 'name', 'lastUsedPrice', 'unit', 'stockCount',
              'lowStockAlert', 'category', 'description', 'isActive', 'updatedAt', 'frequency', 'updatedBy', 'deleted', 'baseName', 'options', 'hasImage'
            ])
          && isValidVariantFields(request.resource.data)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedBy']) || request.resource.data.updatedBy == request.auth.uid)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['deleted']) || (isAdmin(shopId) && request.resource.data.deleted == true));
        // An admin removes a product for good (its picture is deleted with it). Old bills keep the name they were sold under.
        allow delete: if isAdmin(shopId);
      }

      // Catalog pictures: one small JPEG thumbnail (data URL) per product. Not used on bills.
      match /catalogImages/{imageId} {
        allow read: if isMember(shopId);
        allow create, update: if isMember(shopId)
          && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'updatedBy'])
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 70000
          && request.resource.data.data.split(',')[0] == 'data:image/jpeg;base64'
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if isMember(shopId);
      }
    }

    match /users/{userId} {
      allow read: if request.auth.uid == userId;
      allow create, update: if request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['consentRecord'])
        && request.resource.data.consentRecord is map
        && request.resource.data.consentRecord.size() <= 10;
      allow delete: if request.auth.uid == userId;
    }

    match /invites/{code} {
      allow get: if isAuthenticated();
      allow list: if false;

      allow create: if isAuthenticated()
        && isAdmin(request.resource.data.shopId)
        && request.resource.data.keys().hasOnly(['shopId', 'expiresAt', 'claimedBy', 'claimedAt', 'createdBy'])
        && request.resource.data.claimedBy == null
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(7, 'd')
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAuthenticated()
        && resource.data.claimedBy == null
        && request.time < resource.data.expiresAt
        && request.resource.data.claimedBy == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['claimedBy', 'claimedAt']);

      allow delete: if isAuthenticated()
        && isAdmin(resource.data.shopId);
    }

  }
}
