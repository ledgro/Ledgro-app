{
  "appId": "com.ledgro.app",
  "appName": "Ledgro",
  "webDir": "dist",
  "backgroundColor": "#0B1220",
  "android": {
    "allowMixedContent": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "backgroundColor": "#0B1220",
      "showSpinner": false
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    },
    "SystemBars": {
      "insetsHandling": "native"
    }
  }
}
