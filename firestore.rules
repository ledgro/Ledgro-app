rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getShop(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)).data;
    }

    function isMember(shopId) {
      return isAuthenticated() &&
        getShop(shopId).members[request.auth.uid] != null;
    }

    function isAdmin(shopId) {
      return isAuthenticated() &&
        getShop(shopId).members[request.auth.uid] == 'admin';
    }

    // Validation functions
    function isAsciiString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen && val.matches('^[ -~]+$');
    }

    function isValidPhoneNumber(val) {
      return val is string && val.matches('^\\+[1-9]\\d{1,14}$');
    }

    match /shops/{shopId} {
      allow read: if isAuthenticated() &&
        resource.data.members[request.auth.uid] != null;

      allow create: if isAuthenticated() &&
        request.resource.data.members[request.auth.uid] == 'admin' &&
        request.resource.data.members.size() == 1;

      allow update: if isAdmin(shopId)
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['name', 'members', 'phone', 'address', 'tagline', 'updatedAt']);

      allow delete: if isAdmin(shopId);

      match /sessions/{sessionId} {
        allow read: if isMember(shopId);
        // Only allow creating a session, let Cloud Functions or proper logic handle closing
        allow create: if isMember(shopId);
        allow update: if isMember(shopId);
      }

      match /action_locks/{userId} {
        allow read: if isMember(shopId);
        // Lock mechanism: user can write, but rule checks elapsed time
        allow create: if isMember(shopId) && userId == request.auth.uid;
        allow update: if isMember(shopId) && userId == request.auth.uid
          && request.time.toMillis() - resource.data.lastExecutedAt.toMillis() > 10000;
      }

      match /bills/{billId} {
        allow get: if isMember(shopId);
        allow list: if isMember(shopId) && request.query.limit <= 100;

        allow create: if isMember(shopId)
          && request.resource.data.creatorId == request.auth.uid;

        allow update: if isMember(shopId)
          && resource.data.type != 'reversal'
          && request.resource.data.type == 'reversal'
          && request.resource.data.grandTotal == resource.data.grandTotal
          && request.resource.data.creatorId == resource.data.creatorId
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['type', 'originalBillId', 'reversedAt', 'reversedBy']);

        allow delete: if false;
      }

      match /DailySummaries/{dateStr} {
        allow read: if isMember(shopId);
        allow write: if false; // Written by Cloud Function
      }

      match /MonthlySummaries/{monthStr} {
        allow read: if isMember(shopId);
        allow write: if false; // Written by Cloud Function
      }

      match /daily_ledger/{dateStr} {
        allow read: if isMember(shopId);
        allow write: if false; // written by backend
      }

      match /priceVarianceLogs/{logId} {
        allow read: if isAdmin(shopId);
        allow write: if false;
      }

      match /expenses/{expenseId} {
        allow get: if isMember(shopId);
        allow list: if isMember(shopId) && request.query.limit <= 100;
        allow create: if isMember(shopId);
        allow update, delete: if isAdmin(shopId)
          || resource.data.creatorId == request.auth.uid;
      }

      match /catalog/{productId} {
        allow read: if isMember(shopId);
        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly(['name', 'lastUsedPrice', 'unit', 'stockCount', 'lowStockAlert', 'category', 'description', 'isActive', 'updatedAt', 'frequency', 'createdAt'])
          && isAsciiString(request.resource.data.name, 1, 100);
        allow update: if isMember(shopId)
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              'name', 'lastUsedPrice', 'unit', 'stockCount',
              'lowStockAlert', 'category', 'description', 'isActive', 'updatedAt', 'frequency'
            ])
          && (!('name' in request.resource.data) || isAsciiString(request.resource.data.name, 1, 100));
        allow delete: if false;
      }
    }

    match /invites/{code} {
      allow get: if isAuthenticated();
      allow list: if false; // Blocks brute-force enumeration of active invite codes

      allow create: if isAuthenticated()
        && isAdmin(request.resource.data.shopId)
        && request.resource.data.expiresAt > request.time;

      allow update: if isAuthenticated()
        && resource.data.claimedBy == null
        && request.time < resource.data.expiresAt
        && request.resource.data.claimedBy == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['claimedBy', 'claimedAt']);

      allow delete: if isAuthenticated()
        && isAdmin(resource.data.shopId);
    }

    match /adminRecovery/{shopId} {
      allow read: if isAdmin(shopId) || (isMember(shopId) && resource.data.requestedBy == request.auth.uid);
      allow create: if isMember(shopId)
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin(shopId);
      allow delete: if isAdmin(shopId);
    }
  }
}
