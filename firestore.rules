rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getShop(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)).data;
    }

    function isMember(shopId) {
      return isAuthenticated() &&
        getShop(shopId).members[request.auth.uid] != null;
    }

    function isAdmin(shopId) {
      return isAuthenticated() &&
        getShop(shopId).members[request.auth.uid] == 'admin';
    }

    // Validation functions
    function isAsciiString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen && val.matches('^[ -~]+$');
    }



    match /shops/{shopId} {
      allow read: if isAuthenticated() &&
        resource.data.members[request.auth.uid] != null;

      allow create: if isAuthenticated() &&
        request.resource.data.members[request.auth.uid] == 'admin' &&
        request.resource.data.members.size() == 1;

      allow update: if (
          resource.data.members[request.auth.uid] == 'admin'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'members', 'phone', 'address', 'tagline', 'updatedAt'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['members']) || request.resource.data.members.values().hasAny(['admin']))
        ) || (
          // Allow users to remove themselves from the shop when deleting their account
          resource.data.members[request.auth.uid] != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'updatedAt'])
          && request.resource.data.members[request.auth.uid] == null
        );

      allow delete: if resource.data.members[request.auth.uid] == 'admin';

      match /sessions/{sessionId} {
        allow get: if isMember(shopId);
        allow list: if isMember(shopId) && request.query.limit <= 100;
        // Only allow creating a session, let Cloud Functions or proper logic handle closing
        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly(['amount', 'description', 'createdAt', 'creatorId'])
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 200
          && request.resource.data.creatorId == request.auth.uid;
        allow update: if isAdmin(shopId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount', 'description', 'updatedAt'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount']) || (request.resource.data.amount is number && request.resource.data.amount >= 0))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['description']) || (request.resource.data.description is string && request.resource.data.description.size() <= 200));
      }

      match /action_locks/{userId} {
        allow read: if isMember(shopId);
        // Lock mechanism: user can write, but rule checks elapsed time
        allow create: if isMember(shopId) && userId == request.auth.uid
          && request.resource.data.lastExecutedAt == request.time;
        allow update: if isMember(shopId) && userId == request.auth.uid
          && request.resource.data.lastExecutedAt == request.time
          && (resource.data.lastExecutedAt == null || request.time.toMillis() - resource.data.lastExecutedAt.toMillis() > 10000);
      }

      match /bills/{billId} {
        allow get: if isMember(shopId);
        allow list: if isMember(shopId) && request.query.limit <= 100;

        allow create: if isMember(shopId)
          && request.resource.data.creatorId == request.auth.uid
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 100
          && request.resource.data.subtotal is number
          && request.resource.data.subtotal >= 0
          && request.resource.data.grandTotal is number
          && request.resource.data.grandTotal >= 0
          && request.resource.data.paymentMethod is string
          && request.resource.data.paymentMethod in ['cash', 'upi', 'split'];

        allow update: if (isAdmin(shopId) || resource.data.creatorId == request.auth.uid)
          && resource.data.type != 'reversal'
          && request.resource.data.type == 'reversal'
          && request.resource.data.grandTotal == resource.data.grandTotal
          && request.resource.data.creatorId == resource.data.creatorId
          && request.resource.data.reversedBy == request.auth.uid
          && request.resource.data.reversedAt == request.time
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['type', 'originalBillId', 'reversedAt', 'reversedBy']);

        allow delete: if false;
      }

      match /DailySummaries/{dateStr} {
        allow read: if isMember(shopId);
        allow write: if false; // Written by Cloud Function
      }

      match /MonthlySummaries/{monthStr} {
        allow read: if isMember(shopId);
        allow write: if false; // Written by Cloud Function
      }

      match /daily_ledger/{dateStr} {
        allow read: if isMember(shopId);
        allow write: if false; // written by backend
      }

      match /priceVarianceLogs/{logId} {
        allow read: if isAdmin(shopId);
        allow write: if false;
      }

      match /expenses/{expenseId} {
        allow get: if isMember(shopId);
        allow list: if isMember(shopId) && request.query.limit <= 100;

        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly(['amount', 'category', 'description', 'creatorId', 'createdAt', 'clientCreatedAt'])
          && request.resource.data.keys().hasAll(['amount', 'category', 'description', 'creatorId'])
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.category is string
          && request.resource.data.category.size() <= 50
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 200
          && request.resource.data.creatorId == request.auth.uid;

        allow update: if (isAdmin(shopId) || resource.data.creatorId == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount', 'category', 'description', 'updatedAt'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount']) || (request.resource.data.amount is number && request.resource.data.amount >= 0))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['category']) || (request.resource.data.category is string && request.resource.data.category.size() <= 50))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['description']) || (request.resource.data.description is string && request.resource.data.description.size() <= 200));

        allow delete: if isAdmin(shopId);
      }

      match /catalog/{productId} {
        allow read: if isMember(shopId);
        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly(['name', 'lastUsedPrice', 'unit', 'stockCount', 'lowStockAlert', 'category', 'description', 'isActive', 'updatedAt', 'frequency', 'createdAt'])
          && isAsciiString(request.resource.data.name, 1, 100);
        allow update: if isMember(shopId)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['stockCount']) || (request.resource.data.stockCount is number && request.resource.data.stockCount >= 0))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastUsedPrice']) || (request.resource.data.lastUsedPrice is number && request.resource.data.lastUsedPrice >= 0))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']) || isAsciiString(request.resource.data.name, 1, 100))
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              'name', 'lastUsedPrice', 'unit', 'stockCount',
              'lowStockAlert', 'category', 'description', 'isActive', 'updatedAt', 'frequency'
            ]);
        allow delete: if false;
      }
    }

    match /invites/{code} {
      allow get: if isAuthenticated();
      allow list: if false; // Blocks brute-force enumeration of active invite codes

      allow create: if isAuthenticated()
        && isAdmin(request.resource.data.shopId)
        && request.resource.data.expiresAt > request.time;

      allow update: if isAuthenticated()
        && resource.data.claimedBy == null
        && request.time < resource.data.expiresAt
        && request.resource.data.claimedBy == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['claimedBy', 'claimedAt']);

      allow delete: if isAuthenticated()
        && isAdmin(resource.data.shopId);
    }

    match /adminRecovery/{shopId} {
      allow read: if isAdmin(shopId) || (isMember(shopId) && resource.data.requestedBy == request.auth.uid);
      allow create: if isMember(shopId)
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin(shopId);
      allow delete: if isAdmin(shopId);
    }
  }
}
